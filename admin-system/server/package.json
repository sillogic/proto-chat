{
  "name": "protochat-admin-server",
  "version": "1.0.0",
  "description": "ProtoChat Admin System API Server",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:dashboard": "tsx test-dashboard.ts",
    "create-tables": "tsx src/scripts/create-tables.ts",
    "init-db": "tsx src/scripts/create-tables.ts && tsx src/scripts/init-database.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "setup": "npm install && npm run migrate && npm run init-db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.932.0",
    "@bull-board/api": "^6.20.5",
    "@bull-board/express": "^6.20.5",
    "@lobechat/model-runtime": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.5.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "model-bank": "workspace:*",
    "node-fetch": "^2.6.7",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.0",
    "@types/node-fetch": "^2.6.2",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  }
}