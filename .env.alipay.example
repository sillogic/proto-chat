# ============================================================================
# 支付宝支付配置模板
#
# 使用方法：
# 1. 复制此文件内容到 .env.local（开发环境）或 .env.production（生产环境）
# 2. 填写实际的支付宝配置参数
# 3. 确保不要提交包含真实密钥的文件到 Git
# ============================================================================

# ----------------------------------------------------------------------------
# 支付宝支付配置（必填）
# ----------------------------------------------------------------------------

# 支付宝应用 APPID
# 获取方式：登录支付宝开放平台 -> 控制台 -> 应用详情
ALIPAY_APP_ID=2021000000000000

# 应用私钥（RSA2 格式）
# 获取方式：使用支付宝开放平台的密钥生成工具生成，格式必须为 PKCS8（Java适用）
# ⚠️ 请妥善保管，不要泄露！
# 注意：需要去掉"-----BEGIN PRIVATE KEY-----"和"-----END PRIVATE KEY-----"以及所有换行符
ALIPAY_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...

# 支付宝公钥（用于验证签名）
# 获取方式：登录支付宝开放平台 -> 控制台 -> 应用详情 -> 开发设置 -> 接口加签方式（公钥）
# 注意：这里需要的是"支付宝公钥"，不是"应用公钥"
# 注意：需要去掉"-----BEGIN PUBLIC KEY-----"和"-----END PUBLIC KEY-----"以及所有换行符
ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

# 支付宝支付异步通知地址（必须是公网可访问的 HTTPS 地址）
# 格式：https://yourdomain.com/api/payment/alipay/notify
# ⚠️ 需要在支付宝开放平台配置此URL
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/payment/alipay/notify

# 支付宝网关地址（可选，默认为生产环境）
# 生产环境：https://openapi.alipay.com/gateway.do
# 沙箱环境：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 是否使用沙箱环境（可选，默认 false）
# 开发测试时可以设置为 true
ALIPAY_SANDBOX=false

# ----------------------------------------------------------------------------
# Cron 任务密钥（必填）
# ----------------------------------------------------------------------------

# 用于验证 Cron 任务调用的密钥
# 建议使用随机生成的强密码，例如：openssl rand -base64 32
CRON_SECRET=your-random-secret-key-here-please-change-it

# ----------------------------------------------------------------------------
# 数据库配置（如果需要）
# ----------------------------------------------------------------------------

# 生产环境数据库连接字符串（Neon PostgreSQL）
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ----------------------------------------------------------------------------
# 其他可选配置
# ----------------------------------------------------------------------------

# 支付订单过期时间（小时，默认 2 小时）
# PAYMENT_ORDER_EXPIRE_HOURS=2

# 未支付订单保留天数（默认 90 天）
# PAYMENT_ORDER_RETENTION_DAYS=90

# ============================================================================
# 支付宝开放平台配置指南
# ============================================================================

# 1. 登录支付宝开放平台：https://open.alipay.com/
#
# 2. 创建应用：
#    - 进入：控制台 -> 网页&移动应用
#    - 点击"创建应用"
#    - 选择"网页应用"类型
#    - 填写应用信息并提交审核
#
# 3. 配置密钥：
#    - 进入：应用详情 -> 开发设置 -> 接口加签方式（密钥/证书）
#    - 选择"公钥"模式
#    - 下载支付宝官方的"密钥生成工具"生成RSA2密钥对
#    - 上传"应用公钥"到支付宝开放平台
#    - 获取并保存"支付宝公钥"（用于验证支付宝返回的签名）
#
# 4. 配置功能：
#    - 进入：应用详情 -> 功能列表
#    - 添加"当面付"功能
#    - 签约并等待审核通过
#
# 5. 配置接口内容加密方式：
#    - 进入：应用详情 -> 开发设置 -> 接口内容加密方式
#    - 设置为"不加密"（如需加密可自行配置AES密钥）
#
# 6. 配置授权回调地址（网页应用必填）：
#    - 进入：应用详情 -> 开发设置 -> 授权回调地址
#    - 添加：https://yourdomain.com/api/payment/alipay/notify
#
# 7. IP白名单配置（可选，生产环境推荐）：
#    - 进入：应用详情 -> 开发设置 -> 接口加签方式 -> IP白名单
#    - 添加服务器的公网 IP 地址

# ============================================================================
# 密钥格式说明
# ============================================================================

# RSA2 应用私钥格式（PKCS8）：
# MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...
# （这是一串很长的Base64字符串，不包含任何换行符和头尾标记）

# 支付宝公钥格式：
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# （这是一串很长的Base64字符串，不包含任何换行符和头尾标记）

# ⚠️ 常见错误：
# 1. 混淆了"应用公钥"和"支付宝公钥"
#    - ALIPAY_PRIVATE_KEY: 你的应用私钥
#    - ALIPAY_PUBLIC_KEY: 支付宝平台的公钥（不是你的应用公钥）
#
# 2. 密钥格式不正确
#    - 需要使用 PKCS8 格式的私钥
#    - 需要移除所有换行符和头尾标记
#    - 应该是一整串连续的字符串

# ============================================================================
# 测试环境配置
# ============================================================================

# 支付宝提供沙箱环境用于开发测试
#
# 沙箱环境配置步骤：
# 1. 登录支付宝开放平台：https://open.alipay.com/
# 2. 进入：开发者中心 -> 研发服务 -> 沙箱
# 3. 获取沙箱应用的 APPID 和密钥
# 4. 设置环境变量：
#    - ALIPAY_SANDBOX=true
#    - 使用沙箱的 APPID 和密钥
#
# 测试步骤：
# 1. 在测试环境配置以上参数
# 2. 创建测试订单
# 3. 使用支付宝沙箱账号扫码支付（沙箱提供的买家账号）
# 4. 验证回调是否正常接收
# 5. 检查订阅是否正确发放

# ============================================================================
# 安全注意事项
# ============================================================================

# ⚠️ 重要安全提示：
#
# 1. 永远不要将包含真实密钥的 .env 文件提交到 Git
# 2. 确保 .env 文件已添加到 .gitignore
# 3. 生产环境密钥应该使用环境变量或密钥管理服务
# 4. 定期轮换密钥
# 5. 监控异常支付行为
# 6. 启用支付宝的安全提醒功能
# 7. 严格控制服务器权限，防止密钥泄露

# ============================================================================
# Vercel 部署配置
# ============================================================================

# 如果使用 Vercel 部署，需要在项目设置中配置环境变量：
#
# 1. 进入 Vercel 项目 -> Settings -> Environment Variables
# 2. 添加以上所有环境变量
# 3. 选择适用的环境（Production / Preview / Development）
# 4. 保存并重新部署
#
# ⚠️ 注意：由于密钥很长，建议直接复制粘贴，避免手动输入导致错误

# ============================================================================
# 常见问题排查
# ============================================================================

# 1. 提示"验签失败"
#    - 检查是否使用了正确的"支付宝公钥"（不是应用公钥）
#    - 检查密钥格式是否正确（无换行符和头尾标记）
#    - 确认在支付宝开放平台上传了正确的应用公钥
#
# 2. 提示"应用未开通该功能"
#    - 检查是否已添加并签约"当面付"功能
#    - 确认功能审核已通过
#
# 3. 回调通知未收到
#    - 检查 ALIPAY_NOTIFY_URL 是否为公网可访问的 HTTPS 地址
#    - 确认服务器防火墙允许支付宝服务器的请求
#    - 查看应用日志，确认回调接口是否有报错
#
# 4. 二维码无法生成
#    - 检查订单金额是否正确
#    - 确认网络连接正常
#    - 查看错误日志获取详细信息
