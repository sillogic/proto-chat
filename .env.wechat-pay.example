# ============================================================================
# 微信支付配置模板
#
# 使用方法：
# 1. 复制此文件为 .env.local（开发环境）或 .env.production（生产环境）
# 2. 填写实际的微信支付配置参数
# 3. 确保不要提交包含真实密钥的文件到 Git
# ============================================================================

# ----------------------------------------------------------------------------
# 微信支付配置（必填）
# ----------------------------------------------------------------------------

# 微信公众号/小程序 AppID
# 获取方式：登录微信公众平台 -> 开发 -> 基本配置
WECHAT_PAY_APP_ID=wxXXXXXXXXXXXXXXXX

# 微信支付商户号
# 获取方式：登录微信支付商户平台 -> 账户中心 -> 商户信息
WECHAT_PAY_MCH_ID=1600000000

# 微信支付 API 密钥（V2 密钥，用于 Native 支付）
# 获取方式：登录微信支付商户平台 -> 账户中心 -> API安全 -> 设置API密钥
# ⚠️ 请妥善保管，不要泄露！
WECHAT_PAY_API_KEY=your32characterapikeyherexxxx

# 微信支付回调通知地址（必须是公网可访问的 HTTPS 地址）
# 格式：https://yourdomain.com/api/payment/wechat/notify
# ⚠️ 需要在微信商户平台配置此URL到白名单
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/payment/wechat/notify

# ----------------------------------------------------------------------------
# Cron 任务密钥（必填）
# ----------------------------------------------------------------------------

# 用于验证 Cron 任务调用的密钥
# 建议使用随机生成的强密码，例如：openssl rand -base64 32
CRON_SECRET=your-random-secret-key-here-please-change-it

# ----------------------------------------------------------------------------
# 数据库配置（如果需要）
# ----------------------------------------------------------------------------

# 生产环境数据库连接字符串（Neon PostgreSQL）
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ----------------------------------------------------------------------------
# 其他可选配置
# ----------------------------------------------------------------------------

# 支付订单过期时间（小时，默认 2 小时）
# PAYMENT_ORDER_EXPIRE_HOURS=2

# 未支付订单保留天数（默认 90 天）
# PAYMENT_ORDER_RETENTION_DAYS=90

# 是否启用支付沙箱环境（用于测试，默认 false）
# WECHAT_PAY_SANDBOX=false

# ============================================================================
# 微信支付商户平台配置指南
# ============================================================================

# 1. 登录微信支付商户平台：https://pay.weixin.qq.com/
#
# 2. 配置回调URL白名单：
#    - 进入：产品中心 -> 开发配置 -> 支付回调URL
#    - 添加：https://yourdomain.com/api/payment/wechat/notify
#
# 3. 开通 Native 支付：
#    - 进入：产品中心 -> 我的产品
#    - 确保 "Native支付" 已开通
#
# 4. 获取 API 密钥：
#    - 进入：账户中心 -> API安全 -> 设置API密钥
#    - 如果是首次设置，需要先下载证书工具安装
#
# 5. IP白名单配置（生产环境）：
#    - 进入：账户中心 -> API安全 -> IP白名单
#    - 添加服务器的公网 IP 地址
#
# ============================================================================
# 测试环境配置
# ============================================================================

# 微信支付提供沙箱环境用于测试，但 Native 支付不支持沙箱
# 建议使用微信支付的小额测试（0.01元）进行真实测试
#
# 测试步骤：
# 1. 在测试环境配置以上参数
# 2. 创建 0.01 元的测试订单
# 3. 使用微信扫码支付
# 4. 验证回调是否正常接收
# 5. 检查订阅是否正确发放

# ============================================================================
# 安全注意事项
# ============================================================================

# ⚠️ 重要安全提示：
#
# 1. 永远不要将包含真实密钥的 .env 文件提交到 Git
# 2. 确保 .env 文件已添加到 .gitignore
# 3. 生产环境密钥应该使用环境变量或密钥管理服务
# 4. 定期轮换 API 密钥
# 5. 监控异常支付行为
# 6. 启用微信支付的安全提醒功能

# ============================================================================
# Vercel 部署配置
# ============================================================================

# 如果使用 Vercel 部署，需要在项目设置中配置环境变量：
#
# 1. 进入 Vercel 项目 -> Settings -> Environment Variables
# 2. 添加以上所有环境变量
# 3. 选择适用的环境（Production / Preview / Development）
# 4. 保存并重新部署

# ============================================================================
# Vercel Cron 配置
# ============================================================================

# 在 vercel.json 中配置 Cron 任务：
#
# {
#   "crons": [
#     {
#       "path": "/api/cron/subscription",
#       "schedule": "5 0 * * *"
#     },
#     {
#       "path": "/api/cron/cleanup-orders",
#       "schedule": "0 3 * * 0"
#     }
#   ]
# }
#
# Cron 任务会自动调用，Authorization header 会包含 CRON_SECRET
